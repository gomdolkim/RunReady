# Wat Run? — environment variables
# Copy to .env for local development (never commit .env).

# Threads long-lived access token — Meta for Developers (posting).
# This is the ONLY secret the active morning "place of the day" post needs.
THREADS_ACCESS_TOKEN=

# --- Only for the dormant running/evening posts ---
# Anthropic API key — https://console.anthropic.com (EN/TH translation).
ANTHROPIC_API_KEY=
# WAQI air-quality token — https://aqicn.org/data-platform/token (free, email).
# Per-spot PM2.5 (nearest station to each spot's coordinates); running post only.
WAQI_TOKEN=
# Weather/UV/rain comes from Open-Meteo (no API key required).
