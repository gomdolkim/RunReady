# Wat Run? — environment variables
# Copy to .env for local development (never commit .env).

# WAQI air-quality token — https://aqicn.org/data-platform/token (free, email)
WAQI_TOKEN=

# OpenWeather API key — requires "One Call API 3.0" subscription
# https://openweathermap.org/api/one-call-3 (free allowance, card required)
# The same key is used for the Air Pollution API (standard free plan).
OPENWEATHER_API_KEY=

# Anthropic API key — https://console.anthropic.com (Phase 2: translation)
ANTHROPIC_API_KEY=

# Threads long-lived access token — Meta for Developers (Phase 3: posting)
THREADS_ACCESS_TOKEN=
