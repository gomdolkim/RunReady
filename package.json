{
  "name": "wat-run",
  "version": "0.1.0",
  "description": "Wat Run? — daily Bangkok running-conditions bot for Threads (KO/EN/TH)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dry": "tsx src/index.ts --dry-run",
    "verify:translate": "tsx scripts/verifyTranslation.ts",
    "verify:threads": "tsx scripts/verifyThreads.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "dotenv": "^17.4.2"
  }
}
